---
import Header from '@/components/Header.vue';
import Sidebar from '@/components/Sidebar.vue';
---

<!DOCTYPE html>
<html lang="ja" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Progrimo | dashboard</title>
  </head>
  <body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 flex flex-col min-h-screen transition-colors duration-300">

    <!-- ヘッダー -->
    <Header client:load />

    <!-- メインコンテンツ -->
    <main class="mt-[80px] container mx-auto p-6 flex-grow">
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-6">
        <!-- サイドバー -->
        <Sidebar client:load />

        <!-- コンテンツ領域 -->
        <section class="bg-white dark:bg-gray-800 p-6 rounded shadow-md">
          <!-- この部分にダッシュボードの内容を埋め込む -->
          <slot />
        </section>
      </div>
    </main>

    <!-- フッター -->
    <footer class="bg-gray-800 dark:bg-gray-950 text-white dark:text-gray-300 p-4 text-center">
      <p>© 2025 Progrimo</p>
    </footer>

  </body>
</html>

